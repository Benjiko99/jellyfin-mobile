    <!--
        Jellyfin exposes a generic community score and a generic critic score, so these are labelled
        by what the API guarantees rather than by a service name it does not.
    -->
    <string name="detail_rating_community">Community</string>
    <string name="detail_rating_critics_fresh">Critics · Fresh</string>
    <string name="detail_rating_critics_rotten">Critics · Rotten</string>

