<?xml version="1.0" encoding="utf-8"?>
<!--
    Every user-facing string in the app.

    Format is Android's, which is also what Compose Resources reads, and what jellyfin-android's
    Weblate output is in — so importing its 74-locale catalogue later stays a copy rather than a
    conversion. See PLAN.md §2.

    Placeholders are always positional and always `%1$s`: Compose Resources formats these itself on
    iOS rather than going through the platform, and only the indexed string form is reliable across
    both targets. Numbers are passed in already converted.
-->
<resources>

    <!-- ==== App ============================================================================ -->

    <string name="app_name">Jellyfin</string>

    <!-- ==== Shared across screens ========================================================== -->

    <string name="action_retry">Retry</string>
    <string name="action_back">Back</string>
    <string name="action_cancel">Cancel</string>
    <string name="action_load_more">Load more</string>
    <!-- Content description of the chevron beside a row title, which opens the full list. -->
    <string name="action_show_all">Show all</string>

    <!-- Shown when a request failed and the error carried no message of its own. -->
    <string name="error_generic">Could not reach the server</string>
    <!-- A persisted token outlives the app, so it can be revoked while we still hold it. -->
    <string name="error_session_expired">The session has expired. Sign in again.</string>
    <string name="empty_nothing_here">Nothing here.</string>

    <!-- Subtitle under a list heading: how many items the query matched. -->
    <plurals name="item_count">
        <item quantity="one">%1$s item</item>
        <item quantity="other">%1$s items</item>
    </plurals>

    <!-- ==== Sign in ======================================================================== -->

    <string name="login_title">Connect to Jellyfin</string>
    <string name="login_server_address">Server address</string>
    <!-- Example address, not a translatable sentence — kept as a hint of the expected shape. -->
    <string name="login_server_address_hint">192.168.1.10:8096</string>
    <string name="login_username">Username</string>
    <string name="login_password">Password</string>
    <string name="login_sign_in">Sign in</string>
    <string name="login_error_enter_address">Enter a server address</string>
    <string name="login_error_unreachable">Could not reach a Jellyfin server at %1$s</string>
    <string name="login_error_no_token">Server did not return an access token</string>
    <string name="login_error_failed">Sign in failed — check your username and password</string>

