    <!-- ==== Runtimes and episode numbering ================================================= -->

    <!-- "2h 15m". Hours and minutes arrive already split. -->
    <string name="runtime_hours_minutes">%1$sh %2$sm</string>
    <string name="runtime_minutes">%1$sm</string>

    <!-- Season and episode number. Specials often have no season, hence the two partial forms. -->
    <string name="episode_numbering">S%1$s:E%2$s</string>
    <string name="episode_numbering_season_only">S%1$s</string>
    <string name="episode_numbering_episode_only">E%1$s</string>

